# DeepSeek Flash 预配置。复制为 .env（Compose 自动读取）或 .env.local 后填写密钥。
DATA_DIR=./data
SEED_DEMO=true
MAX_UPLOAD_MB=128
# 兼容 Chat Completions 的接口。全部填写后才启用真实生成。
AI_BASE_URL=https://api.deepseek.com
AI_API_KEY=
AI_MODEL=deepseek-flash
# 阿里云百炼文件转写（北京地域 Key）；本机临时上传，无需自备 OSS。
# 通用兼容服务仍可设置 ASR_PROVIDER=openai，并填写其地址与模型。
# 上传后自动后台转写；队列保存在 PostgreSQL，Fastify 服务重启后恢复。
ASR_WORKER_ENABLED=true
ASR_PROVIDER=aliyun
ASR_BASE_URL=https://dashscope.aliyuncs.com/api/v1
ASR_API_KEY=
ASR_MODEL=qwen-audio-3.1-asr-flash-filetrans
ASR_TIMEOUT_SECONDS=180
# 个人配音（百炼 CosyVoice）：为空时复用 aliyun ASR 的 Key 与 /api/v1 地址。
# 新业务空间也可填 https://{WorkspaceId}.cn-beijing.maas.aliyuncs.com/api/v1
TTS_WORKER_ENABLED=true
TTS_BASE_URL=
TTS_API_KEY=
TTS_MODEL=cosyvoice-v3-flash
# 独立视频旁白：画面理解走云端 API，不安装本地视觉或语音模型。
# Key 与地址为空时复用 aliyun ASR 配置，并转换为 /compatible-mode/v1 地址。
NARRATION_WORKER_ENABLED=true
VISION_API_KEY=
VISION_BASE_URL=
VISION_MODEL=qwen3.8-flash
# 可选。本地团队 API 的 Bearer token；设置后界面首次使用需输入。
HUB_ACCESS_TOKEN=
# 只允许本机访问，默认开发命令绑定 127.0.0.1。

# Docker Compose 可选配置。使用 --env-file .env.local 时读取。
HUB_PORT=3100
HUB_BIND_ADDRESS=127.0.0.1

# Fastify / PostgreSQL。复制后设置你自己的数据库密码，不要提交真实凭据。
POSTGRES_PASSWORD=replace_with_a_random_password
# 本机运行时配置可访问的 PostgreSQL；Docker Compose 自动配置容器内地址。
DATABASE_URL=postgresql://hub:replace_with_a_random_password@127.0.0.1:5433/merchant_content_hub
API_PORT=3101
API_INTERNAL_URL=http://127.0.0.1:3101
# 允许其他Web客户端时填写精确来源，逗号分隔；不使用通配符。
HUB_ALLOWED_ORIGINS=

# 抖音链接文案提取：本地 OCR，无需 API Key。可关闭后台 worker。
DOUYIN_WORKER_ENABLED=true

# 视频旁白的字幕翻译复用以上 AI_BASE_URL / AI_API_KEY / AI_MODEL，仅发送旁白文字。
