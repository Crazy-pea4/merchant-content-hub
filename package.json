{
  "name": "merchant-content-hub",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "node scripts/run.mjs dev",
    "build": "npm run build:api && next build",
    "start": "node scripts/run.mjs start",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test tests/*.test.ts",
    "test:smoke": "node scripts/smoke.mjs",
    "test:studio": "node scripts/studio-smoke.mjs",
    "test:browser": "node scripts/browser-smoke.mjs",
    "test:docker": "node scripts/docker-smoke.mjs",
    "test:transcription": "node scripts/transcription-smoke.mjs",
    "test:creation": "node scripts/creation-selection-smoke.mjs",
    "test:search": "node scripts/search-smoke.mjs",
    "test:dubbing": "node scripts/dubbing-smoke.mjs",
    "test:dubbing:preview": "node scripts/dubbing-preview-smoke.mjs",
    "test:dubbing:sentences": "node scripts/dubbing-sentences-smoke.mjs",
    "test:dubbing:postgres": "node scripts/dubbing-postgres-smoke.mjs",
    "test:narration": "node scripts/narration-smoke.mjs",
    "test:narration:postgres": "node scripts/narration-postgres-smoke.mjs",
    "dev:web": "next dev --hostname 127.0.0.1 --port 3100",
    "dev:api": "node --watch --import tsx src/api/main.ts",
    "build:api": "node scripts/build-api.mjs",
    "start:web": "next start --hostname 127.0.0.1 --port 3100",
    "start:api": "node dist/api/api/main.js",
    "test:backend": "node scripts/backend-smoke.mjs",
    "setup": "node scripts/setup-env.mjs"
  },
  "engines": {
    "node": ">=24.11.0"
  },
  "dependencies": {
    "@xyflow/react": "^12.12.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "0.511.0",
    "next": "16.4.5",
    "radix-ui": "^1.8.1",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "tailwind-merge": "^3.7.0",
    "tw-animate-css": "^1.4.0",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "@playwright/test": "^1.60.0",
    "@tailwindcss/postcss": "^4.3.4",
    "@types/node": "^24.0.0",
    "@types/pg": "^8.23.1",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "postcss": "^8.5.32",
    "tailwindcss": "^4.3.4",
    "tsx": "4.21.0",
    "typescript": "5.9.3"
  },
  "type": "module",
  "workspaces": [
    "apps/api"
  ]
}
